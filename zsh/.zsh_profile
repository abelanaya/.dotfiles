export XDG_CONFIG_HOME=$HOME/.config
VIM="nvim"

#PERSONAL=$XDG_CONFIG_HOME/personal

# Personal alias
alias xclip='clipcopy'

# Old ls
# alias ll='ls -lAFhrt'
# alias li='ls -lAFhrti'
# alias l='ls -lAFhrtn'

# Eza (better ls)
alias ll='eza -lgAhF --group-directories-first --icons=auto -s modified'
alias li='ll -i'
alias ln='ll -n'
alias lt='eza -lAhF --tree --level=2 --long --icons --git'

alias oc='opencode'

# Show git untracked + git ignored files
alias glsi='git status --short --untracked-files=all --ignored'

# Git worktree
gwti() {
  if (( $# < 1 )); then
    echo "Usage: gwti <worktree-name> [-- <additional-arguments>]"
    return 1
  fi

  local worktree_name="$1"
  shift

  if (( $# > 0 )); then
    if [[ "$1" != "--" ]]; then
      echo "Usage: gwti <worktree-name> [-- <additional-arguments>]"
      return 1
    fi
    shift
  fi

  local directory="$PWD"
  local repository_root=""

  while true; do
    if [[ -e "$directory/.git" ]]; then
      repository_root="$directory"
    fi

    [[ "$directory" == "/" ]] && break
    directory="${directory:h}"
  done

  if [[ -z "$repository_root" ]]; then
    echo "Error: not inside a git repository"
    return 1
  fi

  local repository_name="${repository_root:t}"
  local worktree_path="$HOME/projects/worktrees/$repository_name/$worktree_name"

  git -C "$worktree_path" worktreeinclude apply --json "$@"
}

# Editor & fzf
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
alias eff='$EDITOR "$(ff)"'

sff() {
    if [ "$#" -eq 0 ]; then
        echo "Usage: sff <destination> (e.g. sff host:/tmp/)"
        return 1
    fi

    local file

    file=$(
        find . -type f -exec stat -f '%m %N' {} + |
            sort -rn |
            cut -d' ' -f2- |
            ff
        ) || return 1

        [ -n "$file" ] || return 1

        scp "$file" "$1"
    }

# open feature macos like
if command -v xdg-open &>/dev/null; then
    open() (
        xdg-open "$@" >/dev/null 2>&1 &
    )
fi

alias v='nvim'
alias vim='nvim'
alias npm='pnpm'

# Source Cargo env if it exists
[[ -f $HOME/.cargo/env ]] && source $HOME/.cargo/env

# Use these sources if installed with clone
#source ~/.fzf/shell/key-bindings.zsh
#source ~/.fzf/shell/completion.zsh

# Configure Bat
export BAT_THEME=TwoDark

export EDITOR=nvim
export GIT_EDITOR=nvim

# Path config
export PATH=$PATH:$HOME/.local/bin:$HOME/.local/scripts

# Bind Tmux sessionizer to Ctrl-f when out of tmux
bindkey -s ^f "$HOME/.local/scripts/tmux-sessionizer.sh\n"

# Enable natural scrolling
if [[ -z xinput ]]; then
    xinput set-prop "ELAN06FA:00 04F3:31AD Touchpad" "libinput Natural Scrolling Enabled" 1
fi

if [[ -z $STOW_FOLDERS ]]; then
    export STOW_FOLDERS="git,i3,nvim,tmux,zsh,rofi,kitty,dunst,scripts,polybar,Xresources,Gtkrc,fonts,neofetch,prettier,ghostty,karabiner,aerospace,herdr,agents"
fi

if [[ -z $DOTFILES ]]; then
    export DOTFILES=$HOME/.dotfiles
fi

function fdf {
    fzf --preview="bat --color=always {}"
}

# Automatically load and unload variables when you cd to folders with .envrc file. For example .envrc file with layout
# python3 will auto create a venv for that folder that is only active while you are on that folder
eval "$(direnv hook zsh)"
#
# Source NVM (Node Version Manager)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# pnpm global store paths
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end
# bun completions
[ -s "~/.bun/_bun" ] && source "~/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# opencode
export PATH=~/.opencode/bin:$PATH

# go
export PATH=~/go/bin:$PATH
